   ]
  },
  {
   "scene": 1,
   "tpl": "thumbs",
   "start": 6.72,
   "end": 13.21,
   "segs": [
    {
     "text": "그리고 이거 전부, 제가 직접 편집한 게 아니라",
     "start": 6.72,
     "end": 9.519
