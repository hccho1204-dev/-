{
 "duration": 581.166,
 "scenes": [
  {
   "scene": 0,
   "tpl": "hero",
   "start": 0.4,
   "end": 6.72,
   "segs": [
    {
     "text": "이 영상들, 전부 같은 대본이에요.",
     "start": 0.4,
     "end": 2.404
